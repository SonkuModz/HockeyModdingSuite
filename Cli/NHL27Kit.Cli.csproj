<Project Sdk="Microsoft.NET.Sdk">

  <!-- nhl27kit: command-line explorer for NHL 27 (PS5) data. Reads the game folder; never writes to it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>nhl27kit</AssemblyName>
    <RootNamespace>NHL27Kit.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\NHL27Kit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Oodle from the user's FMT install (not redistributed with the kit's source). -->
    <None Include="..\ThirdParty\oo2core_9_win64.dll" Condition="Exists('..\ThirdParty\oo2core_9_win64.dll')" CopyToOutputDirectory="PreserveNewest" />
    <!-- Opus (speech) from the user's FMT install. -->
    <None Include="..\ThirdParty\opus.dll" Condition="Exists('..\ThirdParty\opus.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Draft pick ownership (see PuckPedia\README.md): a static snapshot in draft-picks.json, copied
         next to nhl27kit.exe — the CLI reads it from there, no network. The file is in the repo, so the
         build fails without it; refresh it by replacing the repo copy (or the copy next to the exe). -->
    <Content Include="..\PuckPedia\draft-picks.json" Link="draft-picks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
