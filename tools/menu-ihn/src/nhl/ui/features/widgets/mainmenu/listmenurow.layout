{
    "commonName": "Composite",
    "name": "ListMenuRow",
    "height": 105,
    "width": "AUTO",
    "inheritState": false,
    "layout":
    {
        "type": "PanelLayout"
    },
    "style-definitions":
    {
        "DynamicWidth":
        {
            "width": "AUTO",
            "maxWidth": 680
        },
        "FixedWidth":
        {
            "width": 675
        },
        "DescriptionOn":
        {
            "height": 25,
            "marginBottom": 7
        },
        "DescriptionOff":
        {
            "height": 0,
            "marginBottom": 0
        },
        "DarkBackground":
        {
            "backgroundColor": "$LIGHT_GRAY"
        },
        "LightBackground":
        {
            "backgroundColor": "$DARK_BLACK"
        },
        "ActiveBackground":
        {
            "color": "$HIGHLIGHT_SECONDARY"
        },
        "WidgetDeselected":
        {
            "height": 50
        },
        "WidgetSelectedBig":
        {
            "height": 105
        },
        "WidgetSelectedSmall":
        {
            "height": 70
        },
        "DynamicWidthStyle":
        {
            "onSelected":
            [
                "DynamicWidth"
            ]
        },
        "FixedWidthStyle":
        {
            "onSelected":
            [
                "FixedWidth"
            ]
        },
        "ModeTitleSelectedWithDescription":
        {
            "marginTop": 0.0,
            "height": 75
        },
        "ModeTitleSelectedWithoutDescription":
        {
            "marginTop": 0.0,
            "height": 75
        },
        "ModeTitleDeselected":
        {
            "marginTop": 0.0,
            "height": 50
        },
        "ModeTitleLabelDeselected":
        {
            "marginTop": 0.0,
            "height": 56
        },
        "IconNone":
        {
            "iconType": "",
            "NotificationLabel": ""
        },
        "IconExclamation":
        {
            "iconType": "",
            "NotificationLabel": "!"
        },
        "IconMail":
        {
            "iconType": "mail_icon",
            "iconScale": 0.4,
            "NotificationLabel": ""
        },
        "SelectedRowBadgeAlign":
        {
            "marginTop": 0
        },
        "UnselectedRowBadgeAlign":
        {
            "marginTop": 4
        }
    },
    "propertyMap":
    {
        "data.ModeName"                   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.ModeTitle.text",
        "data.Subtitle"                   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.Description.text",
        "data.HeaderTitle"                : "RowGroupHolder.RowGroup.HeaderTitle.text",
        "data.inactiveHiglight"           : "TriggerInactiveHighlight.value",
        "data.inactiveHiglightDescription": "TriggerInactiveHighlightDescription.value",
        "data.headerAltStyle"             : "HeaderAltStyle.value",
        "data.lockedLocString"            : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup.LockedState.text",
        "data.narrationIds"               : "RowGroupHolder.NarrationBehavior.narrationIds",
        "data.dynamicWidth":
        {
            "target"   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.HighlightMask.ControlStateTriggerWidth",
            "property" : "state",
            "converter": "ux.converter.ChooseValueConverter",
            "converterParams":
            {
                "false": "normal",
                "true" : "dynamic"
            }
        },
        "data.haveDescription":
        [
            "ApplyStyleOnDescription.value",
            {
                "target"   : "ControlStateTrigger",
                "property" : "state",
                "converter": "ux.converter.ChooseValueConverter",
                "converterParams":
                {
                    "false": "small",
                    "true" : "normal"
                }
            },
            {
                "target"   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ControlStateTrigger",
                "property" : "state",
                "converter": "ux.converter.ChooseValueConverter",
                "converterParams":
                {
                    "false": "small",
                    "true" : "normal"
                }
            },
            {
                "target"   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.ModeTitle.ControlStateTriggerHeight",
                "property" : "state",
                "converter": "ux.converter.ChooseValueConverter",
                "converterParams":
                {
                    "false": "small",
                    "true" : "normal"
                }
            }
        ],
        "data.state":
        [
            "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.ModeTitle.ControlStateTriggerStyle.state",
            {
                "target"   : "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup",
                "property" : "visible",
                "converter": "ux.converter.ChooseValueConverter",
                "converterParams":
                {
                    "default": false,
                    "active": true,
                    "activealternate": true,
                    "locked": true,
                    "lockednotag": false
                }
            }
        ],
        "data.labelType":
        [
            "ApplyStyleActiveLabel.state"
        ],
        "data.notification.asset": "ApplyNotificationAssetBehavior.state",
        "data.headerMargin": "ChangeHeaderTopMarginOnCustomState.state"
    },
    "behaviors":
    [
        {
            "commonName": "behavior.ApplyPropertiesOnCustomState",
            "name": "ChangeHeaderTopMarginOnCustomState",
            "states":
            {
                "DEFAULT":
                {
                    "RowGroupHolder.RowGroup":
                    {
                        "marginTop": 0
                    }
                },
                "SIMPLE_HEADER_MARGIN":
                {
                    "RowGroupHolder.RowGroup":
                    {
                        "marginTop": 40
                    }
                },
                "DOUBLE_HEADER_MARGIN":
                {
                    "RowGroupHolder.RowGroup":
                    {
                        "marginTop": 80
                    }
                },
                "TRIPLE_HEADER_MARGIN":
                {
                    "RowGroupHolder.RowGroup":
                    {
                        "marginTop": 120
                    }
                }
            }
        },
        {
            "commonName": "behavior.ApplyStyleOnCustomState",
            "name": "ApplyStyleActiveLabel",
            "state": "normal",
            "states":
            {
                "active":
                {
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup.LockedStateBackground":
                    [
                        "ActiveBackground"
                    ],
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup.LockedState":
                    [
                        "FONT_SWATCH_DEFAULT",
                        "NHL_BODY_9_ALT",
                        "WHITE"
                    ]
                },
                "normal":
                {
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup.LockedStateBackground":
                    [
                        "GRAY_COLOR"
                    ],
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup.LockedState":
                    [
                        "FONT_SWATCH_DEFAULT",
                        "NHL_BODY_9_ALT"
                    ]
                }
            }
        },
        {
            "commonName": "behavior.ApplyStyleOnSelection",
            "name": "ShowHiglightAndDescriptiOnSelection",
            "onDeselected":
            [
                "INVISIBLE"
            ],
            "onSelected":
            [
                "VISIBLE"
            ],
            "target":
            [
                "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.Highlight",
                "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.Description"
            ],
            "triggeringElement": "this"
        },
        {
            "commonName": "behavior.ApplyStyleOnSelection",
            "name": "AlignBadgeOnRowTop",
            "onDeselected":
            [
                "UnselectedRowBadgeAlign"
            ],
            "onSelected":
            [
                "SelectedRowBadgeAlign"
            ],
            "target":
            [
                "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.LockedStateGroup"
            ],
            "triggeringElement": "this"
        },
        {
            "commonName": "behavior.ApplyStyleOnBooleanValue",
            "name": "HeaderAltStyle",
            "onFalseStyles":
            [
                "NHL_BODY_8_ALT",
                "LISTMENU_ROW_HEADER_FONT_DEFAULT"
            ],
            "onTrueStyles":
            [
                "NHL_BODY_8_ALT",
                "LISTMENU_ROW_HEADER_FONT_ALTERNATIVE"
            ],
            "targets":
            [
                "RowGroupHolder.RowGroup.HeaderTitle"
            ]
        },
        {
            "commonName": "behavior.ApplyStyleOnBooleanValue",
            "name": "TriggerInactiveHighlightDescription",
            "onTrueStyles":
            [
                "VISIBLE"
            ],
            "targets":
            [
                "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.Description"
            ]
        },
        {
            "commonName": "behavior.ApplyStyleOnBooleanValue",
            "name": "ApplyStyleOnDescription",
            "onTrueStyles":
            [
                "DescriptionOn"
            ],
            "onFalseStyles":
            [
                "DescriptionOff"
            ],
            "targets":
            [
                "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.Description"
            ]
        },
        {
            "commonName": "ButtonTileControlStateTrigger",
            "name": "ControlStateTrigger",
            "state": "normal",
            "target": "ChooseStyle"
        },
        {
            "commonName": "ChooseStyle",
            "name": "ChooseStyle",
            "styleStates":
            {
                "normalselected":
                [
                    "WidgetSelectedBig"
                ],
                "normaldeselected":
                [
                    "WidgetDeselected"
                ],
                "smallselected":
                [
                    "WidgetSelectedSmall"
                ],
                "smalldeselected":
                [
                    "WidgetDeselected"
                ]
            }
        },
        {
            "commonName": "behavior.ApplyStyleOnCustomState",
            "name": "ApplyNotificationAssetBehavior",
            "state": "DEFAULT",
            "states":
            {
                "DEFAULT":
                {
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.Notification":
                    [
                        "INVISIBLE",
                        "IconNone"
                    ]
                },
                "EXCLAMATION":
                {
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.Notification":
                    [
                        "VISIBLE",
                        "IconExclamation"
                    ]
                },
                "MAIL":
                {
                    "RowGroupHolder.RowGroup.HighlightGroupAndLockedState.HighlightGroup.ModeTitleGroup.Notification":
                    [
                        "VISIBLE",
                        "IconMail"
                    ]
                }
            }
        }
