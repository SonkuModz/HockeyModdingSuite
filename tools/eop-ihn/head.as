package overlays.endofperiod
{
   import flash.display.BlendMode;
   import flash.display.GradientType;
   import flash.display.Graphics;
   import flash.display.Loader;
   import flash.display.MovieClip;
   import flash.display.Shape;
   import flash.display.Sprite;
   import flash.events.Event;
   import flash.filters.DropShadowFilter;
   import flash.filters.GlowFilter;
   import flash.geom.Matrix;
   import flash.geom.Rectangle;
   import flash.net.URLRequest;
   import flash.text.TextField;
   import flash.text.TextFieldAutoSize;
   import flash.text.TextFormat;
   import flash.utils.getDefinitionByName;
   import flash.utils.getTimer;

   // IHN (Ice Hockey Network) end-of-period panel for NHL 24, design "A Score Band": the intro's gunmetal band across
   // the bottom (away left, home right) with a centre plate holding the period text and the score, and the IHN logo on
   // top of the plate. Drawn in code; the game drives it like EA's movie (EndOfPeriodOverlay sends SetData(data, sfx),
   // show, hide, dispose). hide is immediate: the overlay is made invisible at the same moment.
   // Generated by make_tpl.py from head.as + the intro's shared drawing code + tail.as.
   public class EndOfPeriodSWF extends MovieClip
   {
      private static const ART:Array = __ART__;

      private static const G1:uint = 0x2A2E35;
      private static const G2:uint = 0x0E1014;
      private static const P1:uint = 0x23272E;
      private static const P2:uint = 0x0B0D10;
      private static const RIM:uint = 0x8B919B;
      private static const GOLD:uint = 0xF2A83A;
      private static const CITY:uint = 0xD7DEE7;

      private static const BX:Number = 150;
      private static const BY:Number = 760;
      private static const HW:Number = 760;
      private static const HH:Number = 170;
      private static const SL:Number = 56;
      private static const LOGO:Number = 140;
      private static const TEXT_W:Number = 320;
      private static const MW:Number = 440;
      private static const MH:Number = 260;
      private static const SHOW_T:Number = 1.0;

      private var _preview:Boolean = false;
      private var _fontHead:String = "$Header";
      private var _fontHeadItalic:String = "$HeaderItalic";
      private var _fontBody:String = "$Default";

      private var _all:Sprite;
      private var _half:Array = [];
      private var _halfArt:Array = [];
      private var _glint:Array = [];
      private var _logo:Array = [];
      private var _logoPath:Array = ["", ""];
      private var _city:Array = [];
      private var _name:Array = [];
      private var _score:Array = [];
      private var _mid:Sprite;
      private var _ihn:Sprite;
      private var _period:TextField;

      private var _p:Number = 0;
      private var _dir:int = 0;
      private var _last:int = 0;
      private var _glintStart:int = 0;
      private var _disposed:Boolean = false;

      public function EndOfPeriodSWF()
      {
         super();
         stop();
         try
         {
            _preview = loaderInfo != null && loaderInfo.parameters != null && loaderInfo.parameters.nhl24kitPreview != null;
         }
         catch(e:Error)
         {
            _preview = false;
         }
         if(_preview)
         {
            _fontHead = _fontHeadItalic = _fontBody = "_sans";
         }
         build();
         apply(0);
         addEventListener(Event.ENTER_FRAME, tick);
         if(_preview)
         {
            previewRun();
         }
      }

      // ------------------------------------------------------------------ the game's API

      public function SetData(d:Object, sfx:Function = null) : void
      {
         if(d == null || _disposed)
         {
            return;
         }
         var c:Array = [colourOf(first(d.AwayPrimaryTeamColor, d.awayTeamColor), d.AwaySecondaryTeamColor),
                        colourOf(first(d.HomePrimaryTeamColor, d.homeTeamColor), d.HomeSecondaryTeamColor)];
         var city:Array = [str(d.AwayTeamCity).toUpperCase(), str(d.HomeTeamCity).toUpperCase()];
         var nm:Array = [str(d.AwayTeamName).toUpperCase(), str(d.HomeTeamName).toUpperCase()];
         var sc:Array = [str(d.AwayTeamScore), str(d.HomeTeamScore)];
         var path:Array = [str(d.AwayTeamLogoPath), str(d.HomeTeamLogoPath)];
         for(var i:int = 0; i < 2; i++)
         {
            paintHalf(i, c[i]);
            setText(_city[i], city[i], _fontBody, 24, CITY, 7, i == 1);
            setText(_name[i], nm[i], _fontHead, 56, 0xFFFFFF, 2, i == 1);
            _name[i].filters = [new GlowFilter(light(c[i]), 0.9, 14, 14, 2, 2), new DropShadowFilter(3, 90, 0, 0.9, 5, 5, 1, 2)];
            fitText(_city[i], TEXT_W, 24, 14);
            fitText(_name[i], TEXT_W, 56, 30);
            placeText(i);
            setText(_score[i], sc[i] != "" ? sc[i] : "0", _fontHead, 140, 0xFFFFFF, 0, false);
            fitText(_score[i], 150, 140, 70);
            _score[i].x = i == 0 ? MW / 2 - 34 - _score[i].width : MW / 2 + 34;
            _score[i].y = 165 - _score[i].height / 2;
            if(path[i] != _logoPath[i])
            {
               _logoPath[i] = path[i];
               loadLogo(_logo[i], path[i]);
            }
         }
         setText(_period, str(d.PeriodString).toUpperCase(), _fontHeadItalic, 34, GOLD, 8, false);
         fitText(_period, MW - 100, 34, 18);
         _period.x = MW / 2 - _period.width / 2;
         _period.y = 46 - _period.height / 2;
      }

      public function show() : void
      {
         if(_disposed)
         {
            return;
         }
         _dir = 1;
         _last = getTimer();
      }

      public function hide() : void
      {
         _dir = 0;
         _p = 0;
         apply(0);
      }

      public function dispose() : void
      {
         _disposed = true;
         hide();
         removeEventListener(Event.ENTER_FRAME, tick);
         for(var i:int = 0; i < 2; i++)
         {
            if(_logo[i] != null)
            {
               clearKids(_logo[i]);
            }
         }
      }

      // ------------------------------------------------------------------ building

      private function build() : void
      {
         _all = new Sprite();
         addChild(_all);
         var band:Sprite = new Sprite();
         band.filters = [new DropShadowFilter(10, 90, 0, 0.65, 18, 18, 1, 2)];
         _all.addChild(band);
         for(var i:int = 0; i < 2; i++)
         {
            var h:Sprite = new Sprite();
            h.y = BY;
            var art:Sprite = new Sprite();
            h.addChild(art);
            _halfArt[i] = art;
            var g:Sprite = new Sprite();
            var gm:Shape = new Shape();
            gm.graphics.beginFill(0);
            halfPath(gm.graphics, i, 0);
            gm.graphics.endFill();
            g.addChild(gm);
            var gl:Shape = new Shape();
            g.addChild(gl);
            gl.mask = gm;
            h.addChild(g);
            _glint[i] = gl;
            var lh:Sprite = new Sprite();
            lh.x = i == 0 ? 80 : HW - 80 - LOGO;
            lh.y = 15;
            h.addChild(lh);
            _logo[i] = lh;
            _city[i] = tf(_fontBody);
            _name[i] = tf(_fontHead);
            h.addChild(_city[i]);
            h.addChild(_name[i]);
            band.addChild(h);
            _half[i] = h;
            paintHalf(i, i == 0 ? 0x2C6BD6 : 0xC8102E);
         }
         _mid = new Sprite();
         _mid.x = 960;
         _mid.y = BY - 60 + MH / 2;
         var mp:Sprite = new Sprite();
         mp.x = -MW / 2;
         mp.y = -MH / 2;
         var m:Graphics = mp.graphics;
         var mx:Matrix = new Matrix();
         mx.createGradientBox(MW, MH, Math.PI / 2, 0, 0);
         m.lineStyle(3, RIM, 1, true);
         m.beginGradientFill(GradientType.LINEAR, [P1, P2], [1, 1], [0, 255], mx);
         m.moveTo(1.5, 1.5);
         m.lineTo(MW - 1.5, 1.5);
         m.lineTo(MW - 41, MH - 1.5);
         m.lineTo(41, MH - 1.5);
         m.lineTo(1.5, 1.5);
         m.endFill();
         m.lineStyle();
         mx = new Matrix();
         mx.createGradientBox(MW - 100, 4, 0, 50, 8);
         m.beginGradientFill(GradientType.LINEAR, [GOLD, GOLD, GOLD], [0, 1, 0], [0, 128, 255], mx);
         m.drawRect(50, 8, MW - 100, 4);
         m.endFill();
         // the dash between the scores
         m.beginFill(GOLD, 1);
         m.drawRect(MW / 2 - 22, 160, 44, 10);
         m.endFill();
         _period = tf(_fontHeadItalic);
         _period.filters = [new GlowFilter(GOLD, 0.35, 12, 12, 2, 2)];
         mp.addChild(_period);
         for(i = 0; i < 2; i++)
         {
            _score[i] = tf(_fontHead);
            _score[i].filters = [new DropShadowFilter(4, 90, 0, 0.9, 8, 8, 1, 2)];
            mp.addChild(_score[i]);
         }
         _mid.addChild(mp);
         band.addChild(_mid);
         // the IHN logo sits on the plate's top edge
         _ihn = new Sprite();
         var logo:Shape = new Shape();
         drawArt(logo.graphics);
         logo.scaleX = logo.scaleY = 0.42;
         logo.x = -300 * 0.42;
         logo.y = -132 * 0.42;
         _ihn.addChild(logo);
         _ihn.x = 960;
         _ihn.y = BY - 60 - 22;
         _ihn.filters = [new DropShadowFilter(6, 90, 0, 0.7, 10, 10, 1, 2)];
         _all.addChild(_ihn);
      }

      private function placeText(i:int) : void
      {
         var c:TextField = _city[i];
         var n:TextField = _name[i];
         if(i == 0)
         {
            c.x = 250;
            n.x = 250;
         }
         else
         {
            c.x = HW - 250 - c.width;
            n.x = HW - 250 - n.width;
         }
         c.y = 54 - c.height / 2;
         n.y = 106 - n.height / 2;
      }

      // ------------------------------------------------------------------ animation

      private function tick(e:Event) : void
      {
         fitLogos();
         var now:int = getTimer();
         var dt:Number = Math.min(0.1, (now - _last) / 1000);
         _last = now;
         if(_dir == 0)
         {
            if(_p >= 1)
            {
               glint(now);
            }
            return;
         }
         _p = Math.min(1, _p + dt / SHOW_T);
         if(_p >= 1)
         {
            _dir = 0;
            _glintStart = now;
         }
         apply(_p);
      }

      private function apply(p:Number) : void
      {
         _all.visible = p > 0;
         var a:Number = seg(p, 0, 0.5);
         _half[0].x = BX - (1 - a) * 1000;
         _half[1].x = 1920 - BX - HW + (1 - a) * 1000;
         _half[0].alpha = _half[1].alpha = Math.min(1, a * 1.6);
         var m:Number = seg(p, 0.3, 0.7);
         _mid.scaleX = _mid.scaleY = 0.6 + 0.4 * m;
         _mid.alpha = m;
         var t:Number = seg(p, 0.55, 1.0);
         _ihn.alpha = t;
         _ihn.y = BY - 60 - 22 - (1 - t) * 40;
         for(var i:int = 0; i < 2; i++)
         {
            _glint[i].visible = false;
         }
      }

      private static function first(a:*, b:*) : *
      {
         return a != null ? a : b;
      }

