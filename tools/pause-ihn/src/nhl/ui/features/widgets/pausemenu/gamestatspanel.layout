{
    "commonName": "Composite",
    "name":"GameStatsPanel",
    "layout":
    {
        "type": "PanelLayout"
    },
    "propertyMap":
    {
        "data.HomeTeam.name": "InformationGroup.HomeTeamName.text",
        "data.HomeTeam.id": "InformationGroup.HomeTeamLogo.id",
        "data.HomeTeam.score": "InformationGroup.MatchInfoGroup.ScoresGroup.HomeScore.text",
        "data.HomeTeam.aggAbbr": "InformationGroup.AggregateScoreGroup.HomeAggregateScore.AggAbbr.text",
        "data.HomeTeam.aggScore":
        [
            "InformationGroup.AggregateScoreGroup.HomeAggregateScore.Value.text",
            {
                "property": "visible",
                "converter": "ux.converter.ChooseValueConverter",
                "target": "InformationGroup.AggregateScoreGroup.HomeAggregateScore",
                "converterParams":
                {
                    "default": true,
                    "-1": false
                }
            }
        ],
        "data.AwayTeam.name": "InformationGroup.AwayTeamName.text",
        "data.AwayTeam.id": "InformationGroup.AwayTeamLogo.id",
        "data.AwayTeam.score": "InformationGroup.MatchInfoGroup.ScoresGroup.AwayScore.text",
        "data.AwayTeam.aggAbbr": "InformationGroup.AggregateScoreGroup.AwayAggregateScore.AggAbbr.text",
        "data.AwayTeam.aggScore":
        [
            "InformationGroup.AggregateScoreGroup.AwayAggregateScore.Value.text",
            {
                "property": "visible",
                "converter": "ux.converter.ChooseValueConverter",
                "target": "InformationGroup.AggregateScoreGroup.AwayAggregateScore",
                "converterParams":
                {
                    "default": true,
                    "-1": false
                }
            }
        ],
        "data.AttrList": "Stats.itemSource",
        "compress": "NormalCompressList.value"
    },
    "backgroundStyles":
    {
        "default":
        [
            "VISIBLE"
        ]
    },
    "behaviors":
    [
        {
            "commonName": "behavior.ApplyPropertyOnBooleanValue",
            "name": "NormalCompressList",
            "onTrue":
            [
                {
                    "type": "PositionItemsInLine",
                    "data":
                    {
                        "paddingBetweenItems": 64
                    }
                },
                {
                    "type": "CalculateLayoutSize"
                },
                {
                    "type": "CalculateWindowPercent"
                }
            ],
            "onFalse":
            [
                {
                    "type": "PositionItemsInLine",
                    "data":
                    {
                        "paddingBetweenItems": 68
                    }
                },
                {
                    "type": "CalculateLayoutSize"
                },
                {
                    "type": "CalculateWindowPercent"
                }
            ],
            "targets":
            [
                "Stats.layoutSteps"
            ],
            "value": false
        }
    ],
    "children":
    [
        {
            "commonName": "Group",
            "name": "InformationGroup",
            "layout":
            {
                "type": "CanvasLayout"
            },
            "children":
