    "animationScripts":
    [
        {
            "name": "HideAnimMainLabel",
            "script":
            [
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "rotationX": 90
                        },
                        "duration": 300,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels"
                        ]
                    }
                },
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "alpha": 1,
                            "marginLeft": 0
                        },
                        "duration": 150,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels.SecondFilterLabel"
                        ]
                    }
                },
                {
                    "type": "Delay",
                    "data":
                    {
                        "duration": 150
                    }
                },
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "alpha": 0
                        },
                        "duration": 150,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels.FilterLabel"
                        ]
                    }
                },
                {
                    "type": "Delay",
                    "data":
                    {
                        "duration": 150
                    }
                },
                {
                    "type": "Function",
                    "data":
                    {
                        "name": "trigger",
                        "target": "OnLabelAnimationComplete"
                    }
                }
            ]
        },
        {
            "name": "ShowAnimMainLabel",
            "script":
            [
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "rotationX": 0
                        },
                        "duration": 300,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels"
                        ]
                    }
                },
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "alpha": 1
                        },
                        "duration": 150,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels.FilterLabel"
                        ]
                    }
                },
                {
                    "type": "Delay",
                    "data":
                    {
                        "duration": 150
                    }
                },
                {
                    "type": "Direct",
                    "data":
                    {
                        "end":
                        {
                            "alpha": 0,
                            "marginLeft": 0
                        },
                        "duration": 150,
                        "easing": "quadInOut",
                        "targets":
                        [
                            "Grid.LabelsGroup.Labels.SecondFilterLabel"
                        ]
                    }
                },
                {
                    "type": "Delay",
                    "data":
                    {
                        "duration": 150
                    }
                },
                {
                    "type": "Function",
                    "data":
                    {
                        "name": "trigger",
                        "target": "OnLabelAnimationComplete"
                    }
                }
            ]
        }
