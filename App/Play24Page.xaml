<UserControl x:Class="NHL27Kit.App.Play24Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- one setting: label and hint, where the value comes from, the control, reset -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:SettingRow}">
            <Grid Margin="0,0,0,2" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                    <TextBlock Text="{Binding Label}" FontFamily="{Binding LabelFont}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{Binding SourceBrush}" FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Right"
                              Visibility="{Binding IsToggle, Converter={StaticResource BoolVisible}}" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" DisplayMemberPath="Label"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolVisible}}" />
                    <DockPanel Visibility="{Binding IsSlider, Converter={StaticResource BoolVisible}}">
                        <Border DockPanel.Dock="Right" Width="52" CornerRadius="6" Background="{StaticResource Surface3}" Padding="0,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding NumberText}" FontSize="12" HorizontalAlignment="Center" />
                        </Border>
                        <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding NumberValue}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Visibility="{Binding IsText, Converter={StaticResource BoolVisible}}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <Grid Margin="22,18,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ hero -->
            <Border CornerRadius="14" Height="300" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Border.Background>
                    <ImageBrush x:Name="HeroArt" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
                </Border.Background>
                <Grid>
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20C0E12" Offset="0" />
                                <GradientStop Color="#C80C0E12" Offset="0.42" />
                                <GradientStop Color="#300C0E12" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000C0E12" Offset="0.55" />
                                <GradientStop Color="#B00C0E12" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,30">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="92" Height="92" CornerRadius="16" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush x:Name="IconArt" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Pill}" Padding="8,1">
                                        <TextBlock Text="PS4" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock x:Name="HeroMeta" Foreground="{StaticResource TextDim}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="HeroTitle" Text="NHL 24" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="Playtime" Foreground="{StaticResource TextDim}" Margin="7,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource Primary}" Padding="30,0" Height="46" FontSize="15" Click="OnPlay"
                                    ToolTip="Opens the NHL24 PC launcher; press its Play to start the game">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="15" />
                                    <TextBlock Text="Play" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Padding="22,0" Height="46" FontSize="15" Click="OnStop" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Stop" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ButtonBase}" Background="#33FFFFFF" BorderBrush="#40FFFFFF" Height="46" Padding="18,0" Margin="10,0,0,0" Click="OnOpenInstall"
                                    ToolTip="Open the NHL24 PC folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="NHL24 PC folder" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="RunningBadge" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" />
                                <TextBlock x:Name="RunningText" Text="Running" Margin="8,0,0,0" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PlayProblem" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ settings + install -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- config bar -->
                    <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="RevertButton" Style="{StaticResource Ghost}" Content="Revert" Click="OnRevert" IsEnabled="False" />
                                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnSave" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Save settings" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Surface3}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ConfigTitle" Text="Emulator settings" FontWeight="SemiBold" />
                                <TextBlock x:Name="ConfigCaption" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl x:Name="Sections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SettingSection}">
                                <Border Style="{StaticResource Card}" Padding="20,16,14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="10,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="NHL24 PC" Style="{StaticResource Overline}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Width="36" Height="36" Padding="0" Margin="8,0,0,0" Click="OnBrowseInstall" ToolTip="Choose the NHL24 PC folder (the one with nhl24.exe)" />
                                <TextBox x:Name="InstallPath" FontFamily="{StaticResource MonoFont}" FontSize="11.5" IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock x:Name="InstallInfo" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="GAME IT RUNS" Style="{StaticResource Overline}" Margin="0,18,0,6" />
                            <Border Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="RunsText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                            <TextBlock x:Name="RunsWarning" Foreground="{StaticResource Patch}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Button x:Name="FixLinkButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0" Click="OnFixLink" Visibility="Collapsed"
                                    ToolTip="Makes NHL24 PC's game link point at the NHL 24 folder HMS has open, so the game plays what HMS changes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Point it at HMS's NHL 24 folder" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,3" Click="OnOpenLog" ToolTip="Open the full log">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" />
                                </Button>
                                <TextBlock Text="CONSOLE" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Height="300">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                                    <TextBlock x:Name="ConsoleText" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="The emulator's log shows here." />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
