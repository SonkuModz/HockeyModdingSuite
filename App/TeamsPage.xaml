<UserControl x:Class="NHL27Kit.App.TeamsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- one value: label and hint, the editor for its kind, "was …" and reset -->
        <DataTemplate x:Key="ValueTemplate" DataType="{x:Type local:TeamValueRow}">
            <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,6" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolVisible}}" />
                        <TextBlock Text="{Binding Was}" FontSize="10.5" Foreground="{StaticResource Patch}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowWas, Converter={StaticResource BoolVisible}}" />
                        <TextBlock Text="{Binding Error}" FontSize="10.5" Foreground="{StaticResource Danger}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolVisible}}" />
                        <DockPanel Visibility="{Binding IsColor, Converter={StaticResource BoolVisible}}">
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="7" Margin="0,0,8,0" Background="{Binding Swatch}"
                                    BorderBrush="#40FFFFFF" BorderThickness="1" />
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="30" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     CharacterCasing="Upper" />
                        </DockPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Right"
                                  Visibility="{Binding IsToggle, Converter={StaticResource BoolVisible}}" />
                        <ComboBox ItemsSource="{Binding Picks}" SelectedItem="{Binding PickValue}" Height="30" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                                  Visibility="{Binding IsPick, Converter={StaticResource BoolVisible}}" />
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Padding="4" Margin="4,0,0,0" Click="OnResetValue" ToolTip="Back to the game's value"
                            VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource BoolVisible}}">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Click="OnReload" Padding="12,6" ToolTip="Read the teams from the game again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="DiscardButton" Click="OnDiscard" Padding="12,6" Margin="8,0,0,0" IsEnabled="False" Content="Discard" />
                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="OnSave" Padding="14,6" Margin="8,0,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock x:Name="SaveLabel" Text="Save to game" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Teams" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search teams — e.g. toronto, TOR, frolunda" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="LeagueFilter" Grid.Column="1" Width="200" Margin="12,0,0,0" SelectionChanged="OnLeagueChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="TeamCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="TEAMS" Style="{StaticResource Overline}" Margin="0" />
                    </DockPanel>
                    <ListBox x:Name="TeamList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" SelectionChanged="OnTeamSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TeamListRow}">
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Surface3}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource TextDim}" />
                    </Border>
                    <TextBlock Text="Pick a team" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Its names, colours and home arena are read from the game's database and saved back into it." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="Editor" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- header: the team as it is now, with its palette -->
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                            <DockPanel>
                                <ItemsControl x:Name="PaletteStrip" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TeamValueRow}">
                                            <Border Width="34" Height="34" CornerRadius="8" Margin="6,0,0,0" Background="{Binding Swatch}" BorderBrush="#40FFFFFF" BorderThickness="1"
                                                    ToolTip="{Binding Text}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Image x:Name="HeaderLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TeamTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TeamMeta" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- logos: every style the game keeps for this team, with Export and Replace -->
                        <Border x:Name="LogosCard" Style="{StaticResource Card}" Padding="18,14,14,8" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource Ghost}" Padding="10,5" Click="OnExportLogos" ToolTip="Save every logo of this team as PNG into a folder">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12" />
                                                <TextBlock Text="Export all" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" Padding="10,5" Margin="8,0,0,0" Click="OnFaceoff"
                                                ToolTip="Centre ice (logo and red line) from a rink on TheFaceoff.net, converted and previewed first">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" />
                                                <TextBlock Text="Centre ice from TheFaceoff.net…" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ReplaceMainButton" Padding="10,5" Margin="8,0,0,0" Click="OnReplaceMain"
                                                ToolTip="One image into the plain logo at every size (XL, large, medium, small, extra small)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="12" />
                                                <TextBlock Text="Replace logo…" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ReplaceAllButton" Padding="10,5" Margin="8,0,0,0" Click="OnReplaceAll"
                                                ToolTip="One image into every menu logo style of this team (not centre ice)" Content="Replace every style…" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Logos" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LogosCaption" Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="LogoGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TeamLogoGroup}">
                                            <StackPanel Margin="0,4,0,4">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Logos}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:TeamLogoRow}">
                                                            <Border Width="132" Margin="0,0,8,8" Padding="8" CornerRadius="8" Background="{StaticResource Surface2}"
                                                                    BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="{Binding Tip}">
                                                                <StackPanel>
                                                                    <Border Height="96" CornerRadius="6" Background="#FF2A2E36">
                                                                        <Grid>
                                                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="8,0,8,6"
                                                                                         Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Label}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                                                    <DockPanel Margin="0,2,0,0">
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="4,2" Click="OnReplaceLogo" ToolTip="Replace with an image…">
                                                                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="11" />
                                                                        </Button>
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="4,2" Click="OnExportLogo" ToolTip="Export as PNG or DDS…">
                                                                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="11" />
                                                                        </Button>
                                                                        <TextBlock Text="{Binding Size}" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="Sections">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TeamSection}">
                                    <Border Style="{StaticResource Card}" Padding="18,14,14,10" Margin="0,0,12,12" Width="470">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ValueTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
