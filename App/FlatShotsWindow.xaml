<Window x:Class="NHL27Kit.App.FlatShotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jersey from shop shots" Width="940" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Jersey from shop shots" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Pick the flat front and back shots of one jersey, as PNGs with a transparent background and laid out like NHL Shop's product images. The whole design comes across, collar included, and the kit's own logos are switched off. Shoulder patches are left out for you to add." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Ghost}" Content="Front shot…" Padding="10,5" HorizontalAlignment="Left" Margin="10" Click="OnPickFront" />
                    <Image x:Name="FrontImage" Stretch="Uniform" Margin="10,0,10,10" RenderOptions.BitmapScalingMode="HighQuality" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Ghost}" Content="Back shot…" Padding="10,5" HorizontalAlignment="Left" Margin="10" Click="OnPickBack" />
                    <Image x:Name="BackImage" Stretch="Uniform" Margin="10,0,10,10" RenderOptions.BitmapScalingMode="HighQuality" />
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="UseButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Use on this jersey" Padding="12,6" IsEnabled="False" Click="OnUse" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Cancel" Padding="12,6" Margin="0,0,8,0" Click="OnCancel" />
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="Pick both shots." />
        </DockPanel>
    </Grid>
</Window>
