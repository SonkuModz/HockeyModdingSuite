<Project Sdk="Microsoft.NET.Sdk">
  <!-- HMS (Hockey Modding Suite): the window of the NHL 27 (PS5) and NHL 24 (PS4) modding kit. The code keeps its
       NHL27Kit names, and the kit its NHL27Kit settings and cache folders, so nothing is lost across the rename. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HMS</AssemblyName>
    <Product>Hockey Modding Suite</Product>
    <ApplicationIcon>Assets\hms.ico</ApplicationIcon>
    <RootNamespace>NHL27Kit.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\NHL27Kit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the GC compacts sooner rather than growing the heap: the kit keeps a large index and sits idle a lot -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Oodle from the user's FMT install (not redistributed: release builds pass -p:NoThirdParty=true). -->
    <None Include="..\ThirdParty\oo2core_9_win64.dll" Condition="Exists('..\ThirdParty\oo2core_9_win64.dll') And '$(NoThirdParty)' != 'true'" CopyToOutputDirectory="PreserveNewest" />
    <!-- Opus (speech) from the user's FMT install. -->
    <None Include="..\ThirdParty\opus.dll" Condition="Exists('..\ThirdParty\opus.dll') And '$(NoThirdParty)' != 'true'" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\hms-icon.png" />
    <Resource Include="Assets\hms-badge.png" />
    <Resource Include="Assets\hms.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
