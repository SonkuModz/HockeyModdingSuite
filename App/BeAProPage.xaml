<UserControl x:Class="NHL27Kit.App.BeAProPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Click="OnReload" Padding="12,6" ToolTip="Read the saves again (drops unsaved changes)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenBackups" Padding="12,6" Margin="8,0,0,0" ToolTip="Open the folder the kit copies a save to before writing it">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Backups" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="OnSave" Padding="14,6" Margin="8,0,0,0" IsEnabled="False"
                        ToolTip="Write the changes into the save (a copy of it goes to the backups folder first)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Save to career" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Be A Pro" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Edit a Be A Pro career's ratings and X-Factors, read from KytyPS5's save folder." Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- careers -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CAREERS" Style="{StaticResource Overline}" Margin="16,14,16,8" />
                    <Grid>
                        <ListBox x:Name="SlotList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSlotPicked">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,6">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextDim}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SlotsEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="16,0" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- the career -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
                        <StackPanel x:Name="Editor" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="ProOverall" DockPanel.Dock="Right" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock x:Name="ProName" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="ProDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="NoRecord" Style="{StaticResource Caption}" Foreground="#E3B341" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                            <StackPanel x:Name="RatingsPanel">
                                <DockPanel Margin="0,18,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="Changes made here move the base copies the career keeps by the same amount." VerticalAlignment="Center" />
                                    <TextBlock Text="RATINGS" Style="{StaticResource Overline}" />
                                </DockPanel>
                                <ItemsControl x:Name="Ratings">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:BapRatingRow}">
                                            <Grid Margin="0,3,22,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="46" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding NameBrush}" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Value}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="X-FACTORS" Style="{StaticResource Overline}" Margin="0,20,0,8" />
                                <ItemsControl x:Name="XFactorRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:BapXFactorRow}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="150" VerticalAlignment="Center" Foreground="{Binding NameBrush}" />
                                                <ComboBox DockPanel.Dock="Right" Width="130" Margin="10,0,0,0" ItemsSource="{Binding TierNames}" SelectedIndex="{Binding TierIndex}" IsEnabled="{Binding HasAbility}" />
                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Expander x:Name="Advanced" Margin="0,22,0,0" Foreground="{StaticResource TextDim}">
                                <Expander.Header>
                                    <TextBlock Text="ADVANCED · NOT CONFIRMED" Style="{StaticResource Overline}" />
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="These are values the kit found in the save but hasn't matched to the game's screens yet. The six pairs fit the energy activities (progress and level); the numbered values are the career's settings, and which one holds trait points, energy or funds isn't known. Change them only on a career you have a backup of." />
                                    <TextBlock Text="Activities" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <ItemsControl x:Name="ActivityRows">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:BapActivityRow}">
                                                <DockPanel Margin="0,3,22,3">
                                                    <TextBox DockPanel.Dock="Right" Width="56" Style="{StaticResource Field}" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" ToolTip="Level" />
                                                    <TextBlock DockPanel.Dock="Right" Text="level" Style="{StaticResource Caption}" Margin="10,0,6,0" VerticalAlignment="Center" />
                                                    <TextBox DockPanel.Dock="Right" Width="64" Style="{StaticResource Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="Progress" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{Binding NameBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Career settings" FontWeight="SemiBold" Margin="0,14,0,6" />
                                    <ItemsControl x:Name="CareerRows">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:BapCareerRow}">
                                                <DockPanel Margin="0,2,18,2">
                                                    <TextBox DockPanel.Dock="Right" Width="84" Style="{StaticResource Field}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding NameBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EditorEmpty" Text="Pick a career." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="Close KytyPS5 before saving. Restore a backup by copying its files back into the slot." />
                <TextBlock x:Name="Detail" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
