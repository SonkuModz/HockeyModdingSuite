<UserControl x:Class="NHL27Kit.App.UniformsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <DataTemplate x:Key="GearZoneTemplate" DataType="{x:Type local:GearZone}">
            <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" MouseLeftButtonDown="OnZoneClick" Cursor="Hand">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0" Background="{Binding Swatch}"
                            BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBox DockPanel.Dock="Right" Width="84" Height="28" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="OnZoneFocus"
                             HorizontalContentAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" CharacterCasing="Upper" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Uniforms" Style="{StaticResource Title}" />
            <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search teams — e.g. toronto, boston, sweden" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="LeagueFilter" Grid.Column="1" Width="200" Margin="12,0,0,0" SelectionChanged="OnLeagueChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- teams -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="TeamCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="TEAMS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="TeamList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnTeamSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TeamRow}">
                                <StackPanel Margin="6,7">
                                    <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 3D -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.7">
                        <GradientStop Color="#2A3240" Offset="0" />
                        <GradientStop Color="#14181F" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Grid>
                    <local:KitViewer x:Name="Viewer" Margin="0,64,0,52" />
                    <DockPanel VerticalAlignment="Top" Margin="18,14,18,0">
                        <ComboBox x:Name="KitPicker" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" SelectionChanged="OnKitPicked" DisplayMemberPath="Label" />
                        <Button x:Name="LegacyButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Legacy jersey…" Padding="10,5" Margin="0,0,8,0"
                                VerticalAlignment="Center" Click="OnLegacy"
                                ToolTip="Convert a jersey made for the older NHL (legacy) template to NHL 27's layout and preview it on this kit" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TeamTitle" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock x:Name="KitTitle" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel VerticalAlignment="Bottom" Margin="18,0,18,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Ghost}" Content="Front" Padding="10,5" Click="OnFront" />
                            <Button Style="{StaticResource Ghost}" Content="Side" Padding="10,5" Click="OnSide" />
                            <Button Style="{StaticResource Ghost}" Content="Back" Padding="10,5" Click="OnBack" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="Drag to turn  ·  scroll to zoom  ·  double-click to reset">
                            <TextBlock Text="Name" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="LetterName" Width="130" MaxLength="16" CharacterCasing="Upper" TextChanged="OnLetteringChanged" />
                            <TextBlock Text="No." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox x:Name="LetterNumber" Width="46" MaxLength="2" TextChanged="OnLetteringChanged" />
                            <ComboBox x:Name="LetterCaptain" Width="64" Margin="10,0,0,0" SelectionChanged="OnLetteringChanged" ToolTip="Captain's letter">
                                <ComboBoxItem Content="—" />
                                <ComboBoxItem Content="C" />
                                <ComboBoxItem Content="A" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="LegacyBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="18,0,18,58" Padding="12,6"
                            CornerRadius="12" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Visibility="Collapsed">
                        <WrapPanel>
                            <TextBlock x:Name="LegacyTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            <CheckBox x:Name="LegacyHideLogos" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                      Content="Blank kit logos"
                                      ToolTip="The game stamps the kit's crest, patches and maker's logo onto the jersey. The legacy art has its own, so they're replaced with blank images." />
                            <Button Style="{StaticResource Ghost}" Content="Save PNG…" Padding="8,4" Click="OnLegacySave" />
                            <Button Style="{StaticResource Ghost}" Content="Discard" Padding="8,4" Margin="2,0,0,0" Click="OnLegacyDiscard" />
                            <Button x:Name="LegacyWrite" Content="Write into game" Padding="12,4" Margin="4,0,0,0" Click="OnLegacyWrite"
                                    ToolTip="Preview only until now. Writes the converted jersey over this kit's jersey color and base color; Restore on the Mods page undoes it." />
                        </WrapPanel>
                    </Border>
                    <StackPanel x:Name="ViewBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="ViewBusyText" Text="Loading the kit from the game…" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel x:Name="ViewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a team" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Its kits are drawn in 3D with the game's own jersey, pants and socks models and textures."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- textures -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="TexCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabTextures" Style="{StaticResource Segment}" GroupName="KitTab" Content="Textures" IsChecked="True" Checked="OnKitTab" />
                            <RadioButton x:Name="TabGear" Style="{StaticResource Segment}" GroupName="KitTab" Content="Helmet &amp; gloves" Checked="OnKitTab" />
                            <RadioButton x:Name="TabSlots" Style="{StaticResource Segment}" GroupName="KitTab" Content="Jersey slots" Checked="OnKitTab" />
                        </StackPanel>
                    </DockPanel>
                    <!-- the team's jersey menu (stockteamjerseys): move, rename, add, remove -->
                    <DockPanel x:Name="SlotsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="SlotsSource" DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="16,0,16,8" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,14">
                            <TextBlock Text="ADD A SLOT  ·  any kit in the game" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                            <TextBox x:Name="AddKitSearch" Style="{StaticResource SearchBox}" Tag="Find a kit — e.g. boston adidas home" Margin="0,0,0,6"
                                     TextChanged="OnAddKitSearch" />
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="AddSlotButton" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" Click="OnAddSlot" ToolTip="Add the picked kit at the bottom of the menu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" />
                                        <TextBlock Text="Add" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ComboBox x:Name="AddKitPicker" DisplayMemberPath="Label" MaxDropDownHeight="420">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock x:Name="SlotStatus" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SlotDiscard" Content="Discard" Padding="12,6" Click="OnSlotDiscard" IsEnabled="False" />
                                <Button x:Name="SlotSave" Style="{StaticResource Primary}" Padding="14,6" Margin="8,0,0,0" Click="OnSlotSave" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Save to game" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="SlotList" Background="Transparent" BorderThickness="0" Padding="10,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SlotRow}">
                                    <Border x:Name="Bd" Margin="0,0,0,6" Padding="8,7" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" MouseLeftButtonUp="OnSlotClick" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" FontSize="11.5" VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="6" Background="{StaticResource Checker}" ClipToBounds="True"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,5" />
                                                <DockPanel Margin="0,0,0,5" Visibility="{Binding HasName, Converter={StaticResource BoolVisible}}">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NameRoom}" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center"
                                                               Margin="6,0,0,0" ToolTip="Bytes the name takes of the old name's space (it's rewritten in place)" />
                                                    <TextBox x:Name="NameBox" Height="26" Padding="6,2" FontSize="11.5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="The kit's name in the jersey menu, in every language the game has it in" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding NameError}" Foreground="{StaticResource Danger}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,5"
                                                           Visibility="{Binding HasNameError, Converter={StaticResource BoolVisible}}" />
                                                <WrapPanel>
                                                    <ComboBox Width="96" Height="26" Padding="6,2" Margin="0,0,10,4" FontSize="11.5" ItemsSource="{Binding Labels}" SelectedItem="{Binding LabelPick}"
                                                              ToolTip="The name the jersey menu gives this slot (Home, Away and Third are the game's; the others aren't checked in game yet)" />
                                                    <CheckBox Style="{StaticResource Switch}" Content="Default" IsChecked="{Binding IsDefault}" FontSize="11.5" Margin="0,0,10,4" VerticalAlignment="Center"
                                                              ToolTip="One of the team's two default uniforms (the home one and the away one)" />
                                                    <CheckBox Style="{StaticResource Switch}" Content="Light" IsChecked="{Binding IsLight}" FontSize="11.5" Margin="0,0,0,4" VerticalAlignment="Center"
                                                              ToolTip="A light (white) jersey, which the game picks for away teams" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource Ghost}" Padding="5,3" Click="OnSlotUp" ToolTip="Move up">
                                                        <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource Ghost}" Padding="5,3" Click="OnSlotDown" ToolTip="Move down">
                                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource Ghost}" Padding="5,3" Click="OnSlotTop" ToolTip="Move to the top">
                                                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource Ghost}" Padding="5,3" Click="OnSlotRemove" ToolTip="Remove from the menu">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                            <Setter TargetName="NameBox" Property="BorderBrush" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <!-- helmet and glove colours (stockteamequipmenttable) -->
                    <DockPanel x:Name="GearPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,14">
                            <TextBlock x:Name="GearStatus" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="GearDiscard" Content="Discard" Padding="12,6" Click="OnGearDiscard" IsEnabled="False" />
                                <Button x:Name="GearSave" Style="{StaticResource Primary}" Padding="14,6" Margin="8,0,0,0" Click="OnGearSave" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Save to game" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="GearSource" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Text="TEAM COLOURS  ·  click one to fill the selected zone" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <ItemsControl x:Name="TeamColors" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" Click="OnTeamColor" Tag="{Binding Hex}" ToolTip="{Binding Hex}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="6" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="HelmetHeader" Text="HELMET" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <ItemsControl x:Name="HelmetZones" ItemTemplate="{StaticResource GearZoneTemplate}" Margin="0,0,0,12" />
                                <TextBlock x:Name="GloveHeader" Text="GLOVES" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <ItemsControl x:Name="GloveZones" ItemTemplate="{StaticResource GearZoneTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    <ListBox x:Name="TexList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:KitTexRow}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource Checker}" ClipToBounds="True" HorizontalAlignment="Left">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border CornerRadius="999" Padding="7,1" Background="{StaticResource Surface3}">
                                                <TextBlock Text="{Binding Map}" FontSize="10.5" Foreground="{Binding MapBrush}" />
                                            </Border>
                                            <Border CornerRadius="999" Padding="7,1" Margin="6,0,0,0" Background="{StaticResource PatchSoft}"
                                                    Visibility="{Binding HasMod, Converter={StaticResource BoolVisible}}">
                                                <TextBlock Text="{Binding ModText}" FontSize="10.5" Foreground="{StaticResource Patch}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Ghost}" Content="Export…" Padding="8,5" Click="OnExport"
                                                ToolTip="Save this texture as it is in the game now, as PNG or DDS" />
                                        <Button Content="Replace…" Padding="10,5" Margin="4,0,0,0" Click="OnReplace" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
