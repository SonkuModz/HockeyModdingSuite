<UserControl x:Class="NHL27Kit.App.VideoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Videos" Style="{StaticResource Title}" />
            <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search videos — e.g. hypestage, scoreboard toronto, projection, wipe" TextChanged="OnSearchChanged" />
            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="9" Padding="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="All" IsChecked="True" Checked="OnCategoryChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="Menus" Checked="OnCategoryChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="Arena" Checked="OnCategoryChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="Transitions" Checked="OnCategoryChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="Modes" Checked="OnCategoryChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="VCat" Content="Training" Checked="OnCategoryChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- list -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="ListCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ListTitle" Text="ALL VIDEOS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VideoRow}">
                                    <Grid Height="48" Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Tint}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Leaf}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock x:Name="ListEmptyTitle" Text="Waiting for the index" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock x:Name="ListEmptyText" Text="Videos appear once the asset index has loaded." Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- inspector -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer x:Name="Inspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="20,18,20,20">
                            <!-- player: the WebView (an HWND) sits under nothing; messages swap it out -->
                            <Border CornerRadius="10" Background="#FF07090D" ClipToBounds="True">
                                <Grid x:Name="PlayerBox" Height="340">
                                    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#07090D" />
                                    <Image x:Name="Snapshot" Stretch="Uniform" Visibility="Collapsed" />
                                    <StackPanel x:Name="PlayerMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="30">
                                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="PlayerMessageText" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CompareButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,3" Click="OnCompare" Visibility="Collapsed" />
                                <TextBlock x:Name="PlayerCaption" Style="{StaticResource Caption}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <TextBlock x:Name="VideoName" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4" />
                            <TextBlock x:Name="VideoPath" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                            <Border x:Name="ModBanner" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Click="OnGoMods" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Mods" FontSize="12" />
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ModBannerText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text}" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="REPLACE" Style="{StaticResource Overline}" Margin="0,18,0,8" />
                            <WrapPanel>
                                <Button x:Name="ReplaceButton" Style="{StaticResource Primary}" Click="OnReplace" Margin="0,0,10,8"
                                        ToolTip="Encode a video (or a picture) to this movie's size, frame rate, length and bytes, then queue it on the Mods page">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ReplaceGlyph" Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock x:Name="ReplaceText" Text="Replace…" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Shape" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,8" />
                                <ComboBox x:Name="FitPicker" Width="190" Margin="0,0,10,8" SelectedIndex="0">
                                    <ComboBoxItem Content="Fill (crop to fit)" />
                                    <ComboBoxItem Content="Fit (black bars)" />
                                    <ComboBoxItem Content="Stretch" />
                                </ComboBox>
                                <CheckBox x:Name="KeepAudio" Style="{StaticResource Switch}" Content="Use the clip's sound" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,8"
                                          ToolTip="For movies with sound: use the clip's audio (else silence)" />
                            </WrapPanel>
                            <TextBlock x:Name="ReplaceInfo" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />

                            <TextBlock Text="EXPORT" Style="{StaticResource Overline}" Margin="0,18,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveRawButton" Click="OnSaveRaw" IsEnabled="False" ToolTip="The movie's file exactly as the game has it">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock x:Name="SaveRawText" Text="WebM" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveMp4Button" Margin="8,0,0,0" Click="OnSaveMp4" IsEnabled="False" ToolTip="Converted to H.264 MP4 with ffmpeg">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="MP4" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Click="OnShowInExplorer" ToolTip="Show the movie's asset in the Explorer">
                                    <TextBlock Text="&#xEC50;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                            </StackPanel>

                            <TextBlock Text="PROPERTIES" Style="{StaticResource Overline}" Margin="0,20,0,8" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14,6">
                                <ItemsControl x:Name="Props">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Property}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a video" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Watch it, save it as WebM or MP4, or replace it with your own clip." Style="{StaticResource Caption}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
