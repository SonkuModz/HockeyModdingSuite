<UserControl x:Class="NHL27Kit.App.Scorebug24Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type local:Scorebug24Field}">
            <Border x:Name="Bd" Width="250" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="{Binding Tip}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0" Background="{Binding Swatch}"
                            BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center"
                            Visibility="{Binding IsColor, Converter={StaticResource BoolVisible}}" />
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding On}" VerticalAlignment="Center"
                              Visibility="{Binding IsFlag, Converter={StaticResource BoolVisible}}" />
                    <TextBox DockPanel.Dock="Right" Width="{Binding BoxWidth}" Height="30" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Visibility="{Binding HasBox, Converter={StaticResource BoolVisible}}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DefaultText}" Foreground="{StaticResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Click="OnReload" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="OriginalButton" Click="OnOriginal" Padding="12,6" Margin="8,0,0,0" ToolTip="Put the score clock back as it was before HMS changed it (undoes every saved change)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Undo HMS changes" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Scorebug" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Open the page to read the score clock from the game." Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- preview -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#C9D3DD" Offset="0" />
                    <GradientStop Color="#E8EEF3" Offset="0.55" />
                    <GradientStop Color="#AEB9C4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Height="250">
                <Viewbox x:Name="PreviewBox" Margin="24,20,260,20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas x:Name="Bug" />
                </Viewbox>
                <!-- where it sits on a 1920x1080 screen -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Width="224" Height="126" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#55000000" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F3F6F9" Offset="0" />
                            <GradientStop Color="#DCE3EA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="Screen" Width="1920" Height="1080">
                            <Rectangle Canvas.Left="958" Canvas.Top="0" Width="4" Height="1080" Fill="#40C8102E" />
                            <Ellipse Canvas.Left="760" Canvas.Top="340" Width="400" Height="400" Stroke="#402A5DB0" StrokeThickness="6" />
                            <Rectangle x:Name="ScreenBug" Fill="#CC1C1C1C" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,148,18,0" Text="On a 1920×1080 screen" Foreground="#555" FontSize="11" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" CornerRadius="10" Padding="10,3" Background="#99000000">
                    <TextBlock x:Name="PreviewNote" Text="Preview · fonts are stand-ins" Foreground="#DDFFFFFF" FontSize="11" />
                </Border>
                <StackPanel x:Name="PreviewBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="PreviewBusyText" Text="Reading the score clock from the game…" Foreground="#333" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource Overline}" Margin="16,14,16,8" />
                    <Border DockPanel.Dock="Bottom" Margin="12,8,12,12" Padding="12,10" CornerRadius="10" Background="{StaticResource Surface2}">
                        <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="This score clock reads its settings when a match starts, so changes need no rebuild of the movie." />
                    </Border>
                    <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnGroupSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Scorebug24Group}">
                                <DockPanel Margin="6,7">
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="7,1" Background="{StaticResource PatchSoft}" VerticalAlignment="Center"
                                            Visibility="{Binding HasChanges, Converter={StaticResource BoolVisible}}">
                                        <TextBlock Text="{Binding ChangeText}" FontSize="10.5" Foreground="{StaticResource Patch}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="18,10,18,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscard" IsEnabled="False" />
                            <Button x:Name="SaveButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnSave" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Save to game" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="State" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,10">
                        <TextBlock x:Name="FieldCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GroupTitle" Text="VALUES" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,8,0">
                        <ItemsControl x:Name="Fields" ItemTemplate="{StaticResource FieldTemplate}" ItemsPanel="{StaticResource Wrap}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
