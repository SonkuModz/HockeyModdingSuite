<UserControl x:Class="NHL27Kit.App.RosterSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- fetch, filters -->
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="FetchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="14,7" Click="OnFetch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock x:Name="FetchLabel" Text="Fetch NHL rosters" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sync with the NHL" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                        <!-- one chip per sync stream: gray = not run / not included, gold = running, green = done, red = failed -->
                        <ItemsControl x:Name="StageList" Margin="0,8,0,2" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <!-- fixed-width chips from the left, wrapping when the window is narrow: a chip's size never follows
                                     its text (long text is cut, full text in the tooltip), and there is room for more leagues -->
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SyncStage}">
                                    <Border x:Name="Chip" Width="185" CornerRadius="6" Padding="10,4" Margin="0,0,8,6" BorderThickness="1"
                                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" ToolTip="{Binding Detail}">
                                        <DockPanel>
                                            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource Faint}" />
                                            <TextBlock x:Name="Label" DockPanel.Dock="Left" Text="{Binding Label}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                            <TextBlock x:Name="Detail" Text="{Binding Detail}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding Detail, Converter={StaticResource NonEmptyVisible}}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource GoodSoft}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Good}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Good}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Good}" />
                                            <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Good}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource DangerSoft}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Danger}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Danger}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Danger}" />
                                            <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FetchStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Reads all 32 teams' current rosters from the NHL's public API (api-web.nhle.com) and, when ticked, all 32 teams' rosters from the AHL (theahl.com) and every team's contracts and draft picks from CapWages (capwages.com) and line combinations from DailyFaceoff (dailyfaceoff.com). Nothing changes until you press Apply." />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="FilterBar" Margin="0,12,0,0" IsEnabled="True">
                    <DockPanel>
                        <TextBox x:Name="SyncSearch" DockPanel.Dock="Right" Width="220" Style="{StaticResource SearchBox}" Tag="Name or team" TextChanged="OnFilter" />
                        <Border CornerRadius="9" Padding="3" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="KindAll" Style="{StaticResource Segment}" GroupName="SyncKind" Content="All" IsChecked="True" Checked="OnFilter" />
                                <RadioButton x:Name="KindMove" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Trades" Checked="OnFilter" />
                                <RadioButton x:Name="KindJoin" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Call-ups" Checked="OnFilter" />
                                <RadioButton x:Name="KindUpdate" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Info" Checked="OnFilter" />
                                <RadioButton x:Name="KindLeft" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Left NHL" Checked="OnFilter" />
                                <RadioButton x:Name="KindMissing" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Not in game" Checked="OnFilter" />
                                <RadioButton x:Name="KindContracts" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Contracts" Checked="OnFilter" />
                                <RadioButton x:Name="KindPicks" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Picks" Checked="OnFilter" />
                                <RadioButton x:Name="KindLines" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Lines" Checked="OnFilter" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="ContractsBox" Content="Include contracts" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="True" Checked="OnContracts" Unchecked="OnContracts" Foreground="{StaticResource TextDim}" />
                        <CheckBox x:Name="PicksBox" Content="Include draft picks" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="True" Checked="OnPicks" Unchecked="OnPicks" Foreground="{StaticResource TextDim}" />
                        <CheckBox x:Name="LinesBox" Content="Include lines" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="True" Checked="OnLines" Unchecked="OnLines" Foreground="{StaticResource TextDim}" />
                        <CheckBox x:Name="AhlBox" Content="Include AHL" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="True" Checked="OnAhl" Unchecked="OnAhl" Foreground="{StaticResource TextDim}" />
                        <CheckBox x:Name="SizesBox" Content="Include heights &amp; weights" VerticalAlignment="Center"
                                  IsChecked="True" Checked="OnSizes" Unchecked="OnSizes" Foreground="{StaticResource TextDim}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- changes -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TickAll" Content="Tick shown" Padding="10,6" Click="OnTickAll" IsEnabled="False" />
                        <Button x:Name="TickNone" Content="Untick shown" Padding="10,6" Margin="8,0,0,0" Click="OnTickNone" IsEnabled="False" />
                        <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Padding="14,6" Margin="8,0,0,0" Click="OnApply" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock x:Name="ApplyLabel" Text="Apply to game" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ApplyStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="ChangeList" Background="Transparent" BorderThickness="0" Padding="6,8,4,4" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SyncRow}">
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanApply}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding KindBrush}">
                                        <TextBlock Text="{Binding KindText}" Foreground="#E6000000" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Patch}"
                                                   Visibility="{Binding Note, Converter={StaticResource NonEmptyVisible}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="Press Fetch NHL rosters to compare the game with today's NHL." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
