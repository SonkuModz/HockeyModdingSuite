<UserControl x:Class="NHL27Kit.App.SoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Sounds" Style="{StaticResource Title}" />
            <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search sounds — e.g. goalhome, horn, commentary, crowd" TextChanged="OnSearchChanged" />
            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="9" Padding="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CatAll" Style="{StaticResource Segment}" GroupName="Cat" Content="All" IsChecked="True" Checked="OnCategoryChanged" />
                    <RadioButton x:Name="CatSpeech" Style="{StaticResource Segment}" GroupName="Cat" Content="Speech" Checked="OnCategoryChanged" />
                    <RadioButton x:Name="CatMusic" Style="{StaticResource Segment}" GroupName="Cat" Content="Music" Checked="OnCategoryChanged" />
                    <RadioButton x:Name="CatSfx" Style="{StaticResource Segment}" GroupName="Cat" Content="SFX" Checked="OnCategoryChanged" />
                    <RadioButton x:Name="CatCrowds" Style="{StaticResource Segment}" GroupName="Cat" Content="Crowds" Checked="OnCategoryChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- list -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="ListCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ListTitle" Text="ALL SOUNDS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnSelected" MouseDoubleClick="OnRowDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SoundRow}">
                                    <Grid Height="48" Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Tint}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Leaf}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,0" Background="{StaticResource PatchSoft}" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPatched, Converter={StaticResource BoolVisible}}">
                                                    <TextBlock Text="PATCH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Patch}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                <TextBlock x:Name="ListEmptyGlyph" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock x:Name="ListEmptyTitle" Text="Waiting for the index" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock x:Name="ListEmptyText" Text="Sounds appear once the asset index has loaded." Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- inspector -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer x:Name="Inspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="20,18,20,20">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CatIconBox" Width="44" Height="44" CornerRadius="11" Background="{StaticResource Surface3}">
                                    <TextBlock x:Name="CatGlyph" Style="{StaticResource Icon}" FontSize="20" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock x:Name="CatText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock x:Name="CatSub" Style="{StaticResource Caption}" Margin="2,5,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="SoundName" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,4" />
                            <TextBlock x:Name="SoundPath" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                            <local:SoundPlayerView x:Name="Player" Margin="0,16,0,0" />
                            <Border x:Name="ModBanner" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CompareButton" Style="{StaticResource Ghost}" Padding="8,4" Click="OnCompare" Visibility="Collapsed" />
                                        <Button Style="{StaticResource Ghost}" Padding="8,4" Click="OnGoMods">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Mods" FontSize="12" />
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="ModBannerText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text}" />
                                </DockPanel>
                            </Border>

                            <StackPanel x:Name="VariationsPanel" Margin="0,16,0,0">
                                <TextBlock x:Name="VariationsTitle" Text="VARIATIONS" Style="{StaticResource Overline}" />
                                <ListBox x:Name="Variations" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="OnVariation"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="7" Padding="10,5" Margin="0,0,6,6" Background="{StaticResource Surface3}"
                                                                BorderThickness="1" BorderBrush="{StaticResource LineStrong}">
                                                            <ContentPresenter TextElement.FontSize="12" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:SoundVariation}">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ReplaceButton" Style="{StaticResource Primary}" Click="OnReplace" ToolTip="Replace this variation with an audio file (WAV, or MP3/OGG/FLAC with ffmpeg)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Replace…" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WavButton" Margin="8,0,0,0" Click="OnExportWav" IsEnabled="False" ToolTip="Every channel, as the game has them">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="WAV" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StereoButton" Margin="8,0,0,0" Click="OnExportStereo" IsEnabled="False" ToolTip="The stereo mix the player uses">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Stereo" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Click="OnShowInExplorer" ToolTip="Show the sound's EBX in the Explorer">
                                    <TextBlock Text="&#xEC50;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                            </StackPanel>

                            <TextBlock Text="PROPERTIES" Style="{StaticResource Overline}" Margin="0,20,0,8" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14,6">
                                <ItemsControl x:Name="Props">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Property}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a sound" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Listen to it, see its waveform, switch between its variations and export it as WAV." Style="{StaticResource Caption}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
