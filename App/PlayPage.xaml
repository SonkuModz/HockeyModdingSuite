<UserControl x:Class="NHL27Kit.App.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- one setting: label and hint, where the value comes from, the control, reset -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:SettingRow}">
            <Grid Margin="0,0,0,2" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                    <TextBlock Text="{Binding Label}" FontFamily="{Binding LabelFont}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{Binding SourceBrush}" FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Where this value comes from: the emulator's default, the build's cfg files, your Kyty global settings, or this game's profile" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Right"
                              Visibility="{Binding IsToggle, Converter={StaticResource BoolVisible}}" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" DisplayMemberPath="Label"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolVisible}}" />
                    <DockPanel Visibility="{Binding IsSlider, Converter={StaticResource BoolVisible}}">
                        <Border DockPanel.Dock="Right" Width="52" CornerRadius="6" Background="{StaticResource Surface3}" Padding="0,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding NumberText}" FontSize="12" HorizontalAlignment="Center" />
                        </Border>
                        <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding NumberValue}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Visibility="{Binding IsText, Converter={StaticResource BoolVisible}}" />
                </Grid>
                <Button Grid.Column="3" Style="{StaticResource Ghost}" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnResetRow" ToolTip="Use the inherited value" Visibility="{Binding Overridden, Converter={StaticResource BoolVisible}}">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <Grid Margin="22,18,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ hero -->
            <Border CornerRadius="14" Height="300" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Border.Background>
                    <ImageBrush x:Name="HeroArt" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
                </Border.Background>
                <Grid>
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20C0E12" Offset="0" />
                                <GradientStop Color="#C80C0E12" Offset="0.42" />
                                <GradientStop Color="#300C0E12" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000C0E12" Offset="0.55" />
                                <GradientStop Color="#B00C0E12" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,30">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="92" Height="92" CornerRadius="16" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush x:Name="IconArt" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Pill}" Padding="8,1">
                                        <TextBlock Text="PS5" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock x:Name="HeroMeta" Foreground="{StaticResource TextDim}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="HeroTitle" Text="NHL 27" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="Playtime" Foreground="{StaticResource TextDim}" Margin="7,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource Primary}" Padding="30,0" Height="46" FontSize="15" Click="OnPlay">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="15" />
                                    <TextBlock Text="Play" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Padding="22,0" Height="46" FontSize="15" Click="OnStop" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock x:Name="StopLabel" Text="Stop" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ButtonBase}" Background="#33FFFFFF" BorderBrush="#40FFFFFF" Height="46" Padding="18,0" Margin="10,0,0,0" Click="OnOpenLauncher"
                                    ToolTip="Open the KytyPS5 launcher that came with this build">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Kyty launcher" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="RunningBadge" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" />
                                <TextBlock x:Name="RunningText" Text="Running" Margin="8,0,0,0" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PlayProblem" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ settings + launch -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- profile bar -->
                    <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="RevertButton" Style="{StaticResource Ghost}" Content="Revert" Click="OnRevert" IsEnabled="False" />
                                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnSave" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Save profile" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Surface3}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileTitle" Text="Game profile" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileCaption" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl x:Name="Sections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SettingSection}">
                                <Border Style="{StaticResource Card}" Padding="20,16,14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="10,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- every env variable -->
                    <Border Style="{StaticResource Card}" Padding="20,14,14,12">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton x:Name="EnvToggle" DockPanel.Dock="Right" Style="{StaticResource ExpandToggle}" Width="28" Height="28" Checked="OnEnvToggle" Unchecked="OnEnvToggle" />
                                <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="EnvTitle" Text="Environment variables" FontSize="14.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="every KYTY_ switch this build reads" Style="{StaticResource Caption}" Margin="10,1,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="EnvRows" ItemTemplate="{StaticResource RowTemplate}" Margin="0,10,0,0" Visibility="Collapsed"
                                          VirtualizingPanel.IsVirtualizing="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="EMULATOR" Style="{StaticResource Overline}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Width="36" Height="36" Padding="0" Margin="8,0,0,0" Click="OnBrowseEmulator" ToolTip="Choose kyty_emulator.exe" />
                                <TextBox x:Name="EmulatorPath" FontFamily="{StaticResource MonoFont}" FontSize="11.5" IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock x:Name="BuildInfo" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="COMMAND" Style="{StaticResource Overline}" Margin="0,18,0,6" />
                            <Border Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="CommandText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource Ghost}" Click="OnCopyCommand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Copy command" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Click="OnOpenRunDir" Margin="4,0,0,0" ToolTip="Saves, trophies and the pipeline cache">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Run folder" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KytyPS5 NHL fork releases -->
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="RefreshReleasesButton" Style="{StaticResource Ghost}" Padding="6,3" Click="OnRefreshReleases" ToolTip="Check GitHub for new builds">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" Padding="6,3" Margin="2,0,0,0" Click="OnOpenReleasesPage" ToolTip="Open a fork's releases on GitHub">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="BUILDS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ReleasesCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="KytyPS5 NHL forks on GitHub" />
                            <ItemsControl x:Name="ReleaseRows" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:KytyBuildRow}">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource Pill}" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolVisible}}">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,6,0,0" Background="{StaticResource Surface3}"
                                                                 Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="{Binding Action}" Click="OnReleaseAction" IsEnabled="{Binding CanAct}"
                                                        VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolVisible}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="ShowAllBuildsButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,2,0,0" Click="OnShowAllBuilds" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,3" Click="OnOpenLog" ToolTip="Open the full log">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" />
                                </Button>
                                <TextBlock Text="CONSOLE" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Height="300">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                                    <TextBlock x:Name="ConsoleText" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="The emulator's output shows here while the game runs." />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
