<UserControl x:Class="NHL27Kit.App.DraftPicksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <ComboBox x:Name="TeamPicker" DockPanel.Dock="Left" Width="280" VerticalAlignment="Center" SelectionChanged="OnTeamPicked" />
                <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,12,0" TextWrapping="Wrap"
                           Text="Pick a team to see its draft picks." />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,10,14">
                <StackPanel>
                    <ItemsControl x:Name="Years">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DraftPickYear}">
                                <StackPanel Margin="0,0,0,16" Opacity="{Binding RowOpacity}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:DraftPickCell}">
                                                <Border Margin="0,0,10,0" Padding="8,6" CornerRadius="9" Background="{StaticResource Surface2}"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RoundLabel}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:DraftPickChip}">
                                                                    <Border x:Name="ChipBd" Margin="0,0,4,4" Padding="7,2" CornerRadius="5" BorderThickness="1"
                                                                            Background="{StaticResource Surface3}" BorderBrush="{StaticResource LineStrong}"
                                                                            ToolTip="{Binding Tip}">
                                                                        <TextBlock x:Name="ChipText" Text="{Binding Abbr}" Foreground="{StaticResource Text}"
                                                                                   FontWeight="SemiBold" FontSize="12" />
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="TradedAway">
                                                                            <Setter TargetName="ChipBd" Property="Background" Value="{StaticResource DangerSoft}" />
                                                                            <Setter TargetName="ChipBd" Property="BorderBrush" Value="{StaticResource Danger}" />
                                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Danger}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Acquired">
                                                                            <Setter TargetName="ChipBd" Property="Background" Value="{StaticResource GoodSoft}" />
                                                                            <Setter TargetName="ChipBd" Property="BorderBrush" Value="{StaticResource Good}" />
                                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Good}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Missing">
                                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Muted}" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="—" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisible}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                        <Border Padding="7,2" CornerRadius="5" BorderThickness="1" Background="{StaticResource Surface3}" BorderBrush="{StaticResource LineStrong}" Margin="0,0,0,4">
                            <TextBlock Text="MIN" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock Text="Own pick" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,16,4" />
                        <Border Padding="7,2" CornerRadius="5" BorderThickness="1" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" Margin="0,0,0,4">
                            <TextBlock Text="CGY" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock Text="Original pick now owned by another team" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,16,4" />
                        <Border Padding="7,2" CornerRadius="5" BorderThickness="1" Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource Good}" Margin="0,0,0,4">
                            <TextBlock Text="EDM" Foreground="{StaticResource Good}" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock Text="Pick acquired from another team" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,4" />
                    </WrapPanel>
                    <TextBlock Text="Read-only: the game stores no conditions on picks, so none are shown. Swapping picks comes later."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
