<UserControl x:Class="NHL27Kit.App.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ImportButton" Click="OnImportPack" ToolTip="Write a .nhl27mod pack's replacements into the game">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Import pack…" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Margin="8,0,16,0" Click="OnExportPack" ToolTip="Save these replacements as one .nhl27mod file to share">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Export pack…" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreAllButton" Click="OnRestoreAll" ToolTip="Put every original back">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Restore all" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyAllButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnApplyAll" ToolTip="Write every replacement that isn't in the game yet">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock x:Name="ApplyAllLabel" Text="Apply all" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Mods" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Replacements you have made, and whether they are in the game." Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- how it works -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14" Background="{StaticResource Surface}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                <TextBlock x:Name="HowText" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12.5" LineHeight="19">
                    Replacements and roster/text edits are listed here. <Bold>Export pack…</Bold> saves them as one .nhl27mod file (the source
                    images, sounds and edited databases), and <Bold>Import pack…</Bold> rebuilds a pack against this game and writes it in.
                    Replacing a texture or sound from its page adds it here. <Bold>Apply</Bold> writes it into the game files, in place: same size, so no
                    TOC changes (a UI file that grows moves into the space of a debug-only file and its index entry follows). Each replacement keeps the original bytes in the kit's mods folder, and <Bold>Restore</Bold> puts them back,
                    checking every byte range first. Close KytyPS5 before applying or restoring.
                </TextBlock>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="8" ItemContainerStyle="{StaticResource RowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ModRow}">
                            <Grid Margin="8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding Tint}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Leaf}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource Patch}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolVisible}}" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="999" Padding="10,3" VerticalAlignment="Top" Margin="0,2,14,0" Background="{StaticResource Surface3}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Apply" Padding="12,5" Click="OnApply" Visibility="{Binding CanApply, Converter={StaticResource BoolVisible}}" />
                                    <Button Content="Restore" Padding="12,5" Margin="6,0,0,0" Click="OnRestore" Visibility="{Binding CanRestore, Converter={StaticResource BoolVisible}}" />
                                    <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Click="OnRemove" ToolTip="Remove from the list (only when not in the game)"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolVisible}}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74C;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                    </Border>
                    <TextBlock Text="No replacements yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="Use Replace… on a texture (Textures page) or a sound (Sounds page). They show up here, ready to apply."
                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
