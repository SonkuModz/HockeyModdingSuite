<UserControl x:Class="NHL27Kit.App.UnusedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- one jersey in the grid: its flat texture, team and folder -->
        <DataTemplate x:Key="UnusedTile" DataType="{x:Type local:UnusedRow}">
            <Border x:Name="Bd" Width="164" Margin="0,0,10,10" CornerRadius="10" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True" ToolTip="{Binding Path}">
                <StackPanel>
                    <Grid Height="146" Background="#0C0F14">
                        <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" CornerRadius="999" Padding="7,1" Background="#CC0B0E13">
                            <TextBlock Text="{Binding LeagueText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" CornerRadius="999" Padding="7,1" Background="{Binding BadgeBrush}">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="9,7,9,8">
                        <TextBlock Text="{Binding TeamText}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KitText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Goal}" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Cursor="Hand" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnReload" Padding="12,6"
                    ToolTip="Read the jersey menus from the game again">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                    <TextBlock Text="Reload" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Unused jerseys" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Jerseys the game has textures for that no team's menu shows." Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search — e.g. boston, utah, legends, adidas" TextChanged="OnSearchChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="ShowFree" Style="{StaticResource Segment}" GroupName="UnusedReason" Content="Can add" IsChecked="True" Checked="OnReasonChanged"
                             ToolTip="Their team is in the database: a menu slot can show them" />
                <RadioButton x:Name="ShowNoTeam" Style="{StaticResource Segment}" GroupName="UnusedReason" Content="No team" Checked="OnReasonChanged"
                             ToolTip="No team in the database has this folder's name" />
                <RadioButton x:Name="ShowAll" Style="{StaticResource Segment}" GroupName="UnusedReason" Content="All" Checked="OnReasonChanged" />
            </StackPanel>
            <ComboBox x:Name="LeagueFilter" Grid.Column="2" Width="170" Margin="12,0,0,0" SelectionChanged="OnLeagueChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- the jerseys -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                        <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="JERSEYS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Padding="14,0,4,6" ItemContainerStyle="{StaticResource TileItem}"
                                 ItemTemplate="{StaticResource UnusedTile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnPicked">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock x:Name="GridEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Text="Open the page to read the jersey menus from the game." />
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- on the player -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.7">
                            <GradientStop Color="#2A3240" Offset="0" />
                            <GradientStop Color="#14181F" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <local:KitViewer x:Name="Viewer" Margin="0,70,0,46" />
                        <StackPanel VerticalAlignment="Top" Margin="18,14,18,0">
                            <TextBlock x:Name="KitTeam" Text="Pick a jersey" Foreground="{StaticResource Text}" FontSize="20" FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="KitPath" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="KitWhy" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="ViewBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="ViewBusyText" Text="Loading the kit from the game…" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12">
                            <Button Style="{StaticResource Ghost}" Content="Front" Padding="10,5" Click="OnFront" />
                            <Button Style="{StaticResource Ghost}" Content="Side" Padding="10,5" Click="OnSide" />
                            <Button Style="{StaticResource Ghost}" Content="Back" Padding="10,5" Click="OnBack" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- into a team's menu -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,18,16">
                    <StackPanel>
                        <TextBlock Text="ADD TO A TEAM'S MENU" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Team" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="AddTeam" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="OnAddChanged" />
                            <TextBlock Grid.Row="2" Text="Name" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <DockPanel Grid.Row="2" Grid.Column="1">
                                <CheckBox x:Name="AddTop" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="First" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Put it first in the menu instead of last" />
                                <CheckBox x:Name="AddLight" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Light" VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="A light (mostly white) jersey: the game pairs light and dark teams" />
                                <ComboBox x:Name="AddLabel" DisplayMemberPath="Label" />
                            </DockPanel>
                        </Grid>
                        <DockPanel Margin="0,14,0,0">
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnAdd" IsEnabled="False" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Add to menu" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="AddStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
