<UserControl x:Class="NHL27Kit.App.LeaguesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- a conference: tick to add it, logo, name, teams -->
        <DataTemplate x:Key="ConfTemplate" DataType="{x:Type local:LeagueConfRow}">
            <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,8" CornerRadius="9" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Picked}" VerticalAlignment="Center" ToolTip="Add this conference" />
                    <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding InGame}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a team card: colour band, logo, names, arena, where it goes -->
        <DataTemplate x:Key="TeamTemplate" DataType="{x:Type local:LeagueTeamRow}">
            <Border x:Name="Bd" Width="268" Margin="0,0,12,12" CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                <StackPanel>
                    <Grid Height="74">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{Binding Primary}" Offset="0" />
                                <GradientStop Color="{Binding Primary}" Offset="0.62" />
                                <GradientStop Color="{Binding Secondary}" Offset="0.62" />
                                <GradientStop Color="{Binding Secondary}" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Border Width="62" Height="62" CornerRadius="31" Background="#F2FFFFFF" HorizontalAlignment="Left" Margin="12,0,0,0">
                            <Image Source="{Binding Logo}" Margin="7" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="7,2" CornerRadius="6" Background="#B0000000">
                            <TextBlock Text="{Binding Abbr}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,9,12,11">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Arena}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Players}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Where}" FontSize="11" Margin="0,6,0,0" Foreground="{Binding WhereBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlayerTemplate" DataType="{x:Type local:LeaguePlayerRow}">
            <Grid Margin="0,0,0,1" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Pos}" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Shoots}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Height}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Weight}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding Born}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <Border Grid.Column="7" CornerRadius="5" Background="{StaticResource GoalSoft}" Height="20" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Overall}" Foreground="{StaticResource Goal}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Click="OnReload" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="VerifyButton" Click="OnVerify" Padding="12,6" Margin="8,0,0,0" ToolTip="Read the game's files again and check the league in them">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Check in game files" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreButton" Click="OnRestore" Padding="12,6" Margin="8,0,0,0" ToolTip="Take the league out of the game (its three files go back as they were)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Remove from game" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Click="OnApply" Padding="14,6" Margin="8,0,0,0" ToolTip="Put the ticked conferences into the game as one league (Restore on the Mods page takes it out)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Add to game" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Leagues" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Custom leagues for NHL 24 Play Now." Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- the league as it goes in -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <DockPanel>
                <Image x:Name="PackLogo" DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="League name" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="LeagueNameBox" Width="120" Height="30" Text="NCAA" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PackTitle" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONFERENCES" Style="{StaticResource Overline}" Margin="2,0,0,8" />
                <TextBlock DockPanel.Dock="Bottom" x:Name="SlotsText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0" />
                <ListBox x:Name="ConfList" ItemTemplate="{StaticResource ConfTemplate}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnConfSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="16,0,8,0">
                <TextBlock DockPanel.Dock="Top" x:Name="TeamsHeader" Text="TEAMS" Style="{StaticResource Overline}" Margin="2,0,0,8" />
                <ScrollViewer x:Name="TeamScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TeamCards" ItemTemplate="{StaticResource TeamTemplate}" ItemsPanel="{StaticResource Wrap}" PreviewMouseLeftButtonUp="OnTeamClick" />
                </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="RosterTitle" Text="ROSTER" Style="{StaticResource Overline}" />
                        <TextBlock x:Name="RosterMeta" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer DockPanel.Dock="Bottom" x:Name="CheckScroller" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
                        <ItemsControl x:Name="CheckList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="11" Foreground="{Binding Brush}" Margin="0,2,8,0" />
                                        <TextBlock Text="{Binding What}" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PlayerList" ItemTemplate="{StaticResource PlayerTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
