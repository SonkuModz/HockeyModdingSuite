<UserControl x:Class="NHL27Kit.App.TexturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:TexTile}">
            <Border x:Name="Card" Width="176" Margin="0,0,10,10" CornerRadius="10" Background="{StaticResource Surface2}" BorderThickness="1"
                    BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="OnTileClick" ToolTip="{Binding Name}">
                <StackPanel>
                    <Border Height="164" CornerRadius="9,9,0,0" Background="{StaticResource Checker}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Faint}" FontSize="18"
                                       Visibility="{Binding Loading, Converter={StaticResource BoolVisible}}" />
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding Failed, Converter={StaticResource BoolVisible}}">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource Faint}" FontSize="18" />
                                <TextBlock Text="no preview" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Text="{Binding Leaf}" FontSize="11.5" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="6" Height="6" Fill="{Binding RoleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Role}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Selection}" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Textures" Style="{StaticResource Title}" />
            <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search textures — e.g. toronto home jersey, mascot, ui/assets" TextChanged="OnSearchChanged" />
            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="9" Padding="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RoleAll" Style="{StaticResource Segment}" GroupName="Role" Content="All" IsChecked="True" Checked="OnRoleChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Role" Content="Color" Checked="OnRoleChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Role" Content="Normal" Checked="OnRoleChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Role" Content="Coeff" Checked="OnRoleChanged" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Role" Content="Other" Checked="OnRoleChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- gallery -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                        <TextBlock x:Name="GalleryCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GalleryTitle" Text="ALL TEXTURES" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="Gallery" Background="Transparent" BorderThickness="0" Padding="14,0,4,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="OnGallerySized">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TexRow}">
                                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="GalleryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                <TextBlock x:Name="GalleryEmptyGlyph" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock x:Name="GalleryEmptyTitle" Text="Waiting for the index" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock x:Name="GalleryEmptyText" Text="Textures appear once the asset index has loaded." Style="{StaticResource Caption}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- inspector -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer x:Name="Inspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="18">
                            <Border CornerRadius="10" Background="{StaticResource Checker}" Height="420" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="Big" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel x:Name="BigBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}" />
                                        <TextBlock Text="Decoding…" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="BigProblem" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <DockPanel Margin="0,12,0,0">
                                <ComboBox x:Name="MipPicker" DockPanel.Dock="Right" Width="178" SelectionChanged="OnMipChanged" />
                                <ComboBox x:Name="LayerPicker" DockPanel.Dock="Right" Width="120" Margin="0,0,8,0" SelectionChanged="OnLayerChanged" Visibility="Collapsed"
                                          ToolTip="This texture is an array: pick the layer to show and replace" />
                                <Border CornerRadius="8" Padding="3" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="RGBA" Tag="" IsChecked="True" Checked="OnChannelChanged" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="RGB" Checked="OnChannelChanged" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="R" Checked="OnChannelChanged" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="G" Checked="OnChannelChanged" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="B" Checked="OnChannelChanged" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Channel" Content="A" Checked="OnChannelChanged" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <TextBlock x:Name="TexName" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,4" />
                            <TextBlock x:Name="TexPath" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <WrapPanel x:Name="Pills" Margin="0,10,0,0" />
                            <Border x:Name="ModBanner" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CompareButton" Style="{StaticResource Ghost}" Padding="8,4" Click="OnCompare" Visibility="Collapsed" />
                                        <Button Style="{StaticResource Ghost}" Padding="8,4" Click="OnGoMods">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Mods" FontSize="12" />
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="ModBannerText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text}" />
                                </DockPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="ReplaceButton" Style="{StaticResource Primary}" Click="OnReplace" ToolTip="Replace this texture with an image (any size: it is scaled to fit)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Replace…" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PngButton" Margin="8,0,0,0" Click="OnExportPng">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="PNG" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DdsButton" Margin="8,0,0,0" Click="OnExportDds" ToolTip="The shown mip as DDS (block-compressed, un-tiled)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="DDS" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Click="OnShowInExplorer" ToolTip="Show the texture's EBX in the Explorer">
                                    <TextBlock Text="&#xEC50;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                            </StackPanel>

                            <TextBlock Text="PROPERTIES" Style="{StaticResource Overline}" Margin="0,20,0,8" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14,6">
                                <ItemsControl x:Name="Props">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Property}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a texture" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="See it full size, check each channel and mip, and export it as PNG or DDS." Style="{StaticResource Caption}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
