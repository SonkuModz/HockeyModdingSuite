<Window x:Class="NHL27Kit.App.PhotoJerseyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jersey from a photo" Width="1240" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource Bg}">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Jersey from a photo" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Mark the stripes and the crest on a photo of the jersey: the colours are read off the photo and measured against the game's model, then turned into a color map for this kit. The maker's, NHL and sponsor logos are left off; the crest is painted in. Use as many photos as you like: what's read from each is kept." />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- the photo -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="PhotoEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Text="Open a photo of the jersey: front on and flat works best." />
                        <Viewbox x:Name="PhotoBox" Margin="10" Stretch="Uniform">
                            <Grid>
                                <Image x:Name="Photo" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas x:Name="Marks" Background="Transparent" Cursor="Cross"
                                        MouseLeftButtonDown="OnMarkDown" MouseMove="OnMarkMove" MouseLeftButtonUp="OnMarkUp" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- tools and what's been read -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel Margin="14">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" x:Name="ApplyButton" Content="Use on the jersey" Padding="12,6" Click="OnApply" IsEnabled="False" />
                                <Button Style="{StaticResource Ghost}" Content="Cancel" Padding="10,6" HorizontalAlignment="Left" Click="OnCancel" />
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Style="{StaticResource Ghost}" Content="Open a photo…" Padding="10,5" HorizontalAlignment="Left" Click="OnOpen" />
                                <TextBlock x:Name="PhotoName" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="MARK" Style="{StaticResource Overline}" Margin="0,14,0,6" />
                                <WrapPanel x:Name="Tools">
                                    <RadioButton Style="{StaticResource Segment}" Uid="body" Content="Body stripes" IsChecked="True" Checked="OnTool" Margin="0,0,4,4" />
                                    <RadioButton Style="{StaticResource Segment}" Uid="sleeve" Content="Sleeve stripes" Checked="OnTool" Margin="0,0,4,4" />
                                    <RadioButton Style="{StaticResource Segment}" Uid="crest" Content="Crest" Checked="OnTool" Margin="0,0,4,4" />
                                    <RadioButton Style="{StaticResource Segment}" Uid="collar" Content="Collar" Checked="OnTool" Margin="0,0,4,4" />
                                    <RadioButton Style="{StaticResource Segment}" Uid="yoke" Content="Shoulders" Checked="OnTool" Margin="0,0,4,4" />
                                </WrapPanel>
                                <TextBlock x:Name="ToolHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <CheckBox x:Name="RoundCrest" Style="{StaticResource Switch}" Content="Round crest (cut a circle)" Margin="0,8,0,0" Click="OnRound" />

                                <TextBlock Text="READ FROM THE PHOTOS" Style="{StaticResource Overline}" Margin="0,16,0,6" />
                                <StackPanel x:Name="Results" />
                                <Border x:Name="CrestFrame" Background="{StaticResource Checker}" CornerRadius="6" Width="140" Height="140" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Image x:Name="CrestImage" Stretch="Uniform" Margin="6" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
