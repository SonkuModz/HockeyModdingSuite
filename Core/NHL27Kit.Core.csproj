<Project Sdk="Microsoft.NET.Sdk">

  <!-- NHL27Kit's reader for NHL 27's PS5 data (layout, superbundle TOCs, bundles, assets, textures), ported from
       NHL24Kit.Game, with no dependency on FMT. Oodle (oo2core_9_win64.dll) is the one native library it calls. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NHL27Kit.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NHL 24's EBX type guids and texture formats; NHL 27 keeps most of them, unknown ones show as guids. -->
    <EmbeddedResource Include="Data\typetables.json" LogicalName="typetables.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

</Project>
